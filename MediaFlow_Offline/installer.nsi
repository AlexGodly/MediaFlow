; NSIS Installer Script
; Generated by ExeForge HTML to Windows EXE Builder

!define PRODUCT_NAME "MediaFlow Offline"
!define PRODUCT_VERSION "36.0.0"
!define PRODUCT_PUBLISHER "Alex Godly"
!define PRODUCT_DIR_REGKEY "Software\Microsoft\Windows\CurrentVersion\App Paths\MediaFlow Offline.exe"
!define PRODUCT_UNINST_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\MediaFlow Offline"

SetCompressor lzma

!include "MUI2.nsh"

Name "MediaFlow Offline ${PRODUCT_VERSION}"
OutFile "dist\MediaFlow Offline-Setup-${PRODUCT_VERSION}.exe"
InstallDir "$PROGRAMFILES\MediaFlow Offline"
InstallDirRegKey HKLM "${PRODUCT_DIR_REGKEY}" ""
ShowInstDetails show
ShowUnInstDetails show

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "English"

Section "MainSection" SEC01
  SetOutPath "$INSTDIR"
  SetOverwrite ifnewer
  File /r "dist\win-unpacked\*"
  CreateDirectory "$SMPROGRAMS\MediaFlow Offline"
  CreateShortCut "$SMPROGRAMS\MediaFlow Offline\MediaFlow Offline.lnk" "$INSTDIR\MediaFlow Offline.exe"
  CreateShortCut "$DESKTOP\MediaFlow Offline.lnk" "$INSTDIR\MediaFlow Offline.exe"
SectionEnd

Section -Post
  WriteUninstaller "$INSTDIR\Uninstall.exe"
  WriteRegStr HKLM "${PRODUCT_DIR_REGKEY}" "" "$INSTDIR\MediaFlow Offline.exe"
  WriteRegStr HKLM "${PRODUCT_UNINST_KEY}" "DisplayName" "MediaFlow Offline"
  WriteRegStr HKLM "${PRODUCT_UNINST_KEY}" "UninstallString" "$INSTDIR\Uninstall.exe"
  WriteRegStr HKLM "${PRODUCT_UNINST_KEY}" "DisplayVersion" "${PRODUCT_VERSION}"
  WriteRegStr HKLM "${PRODUCT_UNINST_KEY}" "Publisher" "Alex Godly"
SectionEnd

Section Uninstall
  RMDir /r "$INSTDIR"
  Delete "$SMPROGRAMS\MediaFlow Offline\MediaFlow Offline.lnk"
  RMDir "$SMPROGRAMS\MediaFlow Offline"
  Delete "$DESKTOP\MediaFlow Offline.lnk"
  DeleteRegKey HKLM "${PRODUCT_UNINST_KEY}"
  DeleteRegKey HKLM "${PRODUCT_DIR_REGKEY}"
SectionEnd
